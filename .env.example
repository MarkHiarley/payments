# Copy to .env (`make up` does it for you) and adjust before running anything outside local dev.

# --- PostgreSQL ---
# Host used by tools running on your machine (migrate, go run). docker-compose overrides it to "db" inside the api container.
POSTGRES_HOST=localhost
POSTGRES_USER=payments
POSTGRES_PASSWORD=payments
POSTGRES_DB=payments
# Host port published by the postgres container (container always listens on 5432).
POSTGRES_PORT_EXTERNAL=5432

# --- API ---
# Host port published by the api container (the binary itself always listens on 8080).
API_PORT=8080

# --- Redis ---
# Host used by tools running on your machine. docker-compose overrides it to "redis" inside the api container.
REDIS_HOST=localhost
REDIS_PASSWORD=redis
# Host port published by the redis container (container always listens on 6379).
REDIS_PORT=6379

# --- Auth ---
# Placeholder only. Generate a real random secret for any shared/non-local environment.
JWT_SECRET_TOKEN=change-me

# --- golang-migrate ---
# Must point at POSTGRES_HOST/POSTGRES_PORT_EXTERNAL above so `make migrate` reaches the published port.
DATABASE_URL=postgres://payments:payments@localhost:5432/payments?sslmode=disable
